# --- Database (required for form submissions and the admin panel) ---
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
MONGODB_DB_NAME=goldenfalcone

# --- Admin authentication (required for /admin) ---
# Random secret of at least 32 characters used to encrypt the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every administrator out.
SESSION_SECRET=
# Create the first administrator with:  npm run admin:create -- --email you@example.com --name "Your Name"
# Optional, for non-interactive deployments only (otherwise you are prompted):
# ADMIN_PASSWORD=

# --- Public site settings ---
# Canonical production URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Client-confirmed contact details. Leave blank to hide the related buttons/links.
# These are the initial values; once saved in Admin → Settings, the admin values are used instead.
# WhatsApp number in international format, digits only (e.g. 919790586474)
NEXT_PUBLIC_WHATSAPP_NUMBER=919790586474
GOLDENFALCONE_WHATSAPP_NUMBER=919790586474
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=+91 97905 86474
NEXT_PUBLIC_CONTACT_ADDRESS=

# --- Candidate CV uploads ---
# "none"  : CV upload field is hidden (default)
# "local" : files are written to ./private-uploads (self-hosted servers only, NOT Vercel)
CV_STORAGE_PROVIDER=none
NEXT_PUBLIC_CV_UPLOADS_ENABLED=false

# --- Email notifications (not implemented yet) ---
# Set once an email provider is integrated; until then the admin notification preference has no effect.
# EMAIL_PROVIDER=

# --- Cloudinary Asset Storage (Recommended for production/serverless) ---
# Provide either CLOUDINARY_URL or the 3 individual credentials below.
# If omitted, assets fall back to MongoDB GridFS.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=rmvtp8gb
CLOUDINARY_API_KEY=274225337241254
CLOUDINARY_API_SECRET=efHdc-71WKWfPlFITQBXk60xdBI
CLOUDINARY_FOLDER=goldenfalcone
